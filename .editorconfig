# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Admin scripts use 2 spaces (no build step, plain JS).
[*.js]
indent_style = space
indent_size = 2

# Admin stylesheets use 4 spaces.
[*.css]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[{*.pot,*.po}]
trim_trailing_whitespace = false

[LICENSE]
indent_style = unset
indent_size = unset
